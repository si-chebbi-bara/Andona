# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# AI providers: gemini (default) falls back to ollama
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local PostgreSQL (see the Build Plan, Step 3)
DATABASE_URL=postgresql://andona:andona@localhost:5432/andona

# Secret used to sign login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change_me
